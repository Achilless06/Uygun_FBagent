# Copy this file to .env and fill in real values.
# Never commit .env — it is gitignored.

# ─── Telegram ────────────────────────────────────────────────────────────────
# Bot token from @BotFather (e.g. 7123456789:AAH...)
TELEGRAM_BOT_TOKEN=

# Your personal Telegram chat ID (get from @userinfobot — a numeric value).
# The bot will ONLY respond to this chat ID.
TELEGRAM_ADMIN_CHAT_ID=

# ─── Anthropic (Claude) ──────────────────────────────────────────────────────
# API key from https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ─── Google Gemini ───────────────────────────────────────────────────────────
# API key from https://aistudio.google.com (free tier is sufficient for text).
GOOGLE_API_KEY=
# gemini-3.5-flash is the current-gen workhorse (needs billing enabled).
# Free-tier alternative: gemini-3.5-flash-lite or gemini-2.5-flash-lite.
GEMINI_TEXT_MODEL=gemini-3.5-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image-preview

# ─── Meta / Facebook ─────────────────────────────────────────────────────────
META_APP_ID=
META_APP_SECRET=
# Numeric ID of the Uygun Georgia Facebook Page.
FB_PAGE_ID=
# Never-expiring Page Access Token (obtained via Graph API token exchange, see README).
FB_PAGE_ACCESS_TOKEN=

# ─── Runtime ─────────────────────────────────────────────────────────────────
# DRY_RUN=true: never call Facebook Graph API for publishing — log instead.
# Default to true during local dev; set to false in Railway only when ready.
DRY_RUN=true

TIMEZONE=Asia/Tbilisi
MONTHLY_BUDGET_USD=20
DATABASE_URL=sqlite:///data/uygun.db
LOG_LEVEL=INFO

# ─── Admin upload UI (/admin/photos) ─────────────────────────────────────────
# Protects the per-product photo upload page from public access.
# Browser will pop a Basic Auth prompt the first time; choose a strong password
# you can let your browser keychain remember.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-before-public-deploy
# Used to build the magic-link URL the /upload Telegram command returns.
# In dev keep http://localhost:8000. In production set to https://uygungeorgia.com.
PUBLIC_BASE_URL=http://localhost:8000

# ─── Airtable (Monthly Top Sellers — /import_sales handler) ──────────────────
# Personal Access Token from https://airtable.com/create/tokens.
# Required scopes: data.records:read, data.records:write, schema.bases:read.
# Access: the "Uygun CRM" base only.
# Without this set, /import_sales tells the founder how to provision it
# and refuses to push (the rest of the bot keeps working).
AIRTABLE_TOKEN=
# Base + table IDs default to the ones the bot creates on first setup.
# Override only if you replace the base/table.
AIRTABLE_BASE_ID=appWU0o0Xxz44L6Xo
AIRTABLE_MONTHLY_TABLE_ID=tblptYd9f06LUdRMp
