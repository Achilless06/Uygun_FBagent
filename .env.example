# Copy this file to .env and fill in real values.
# Never commit .env — it is gitignored.

# ─── Telegram ────────────────────────────────────────────────────────────────
# Bot token from @BotFather (e.g. 7123456789:AAH...)
TELEGRAM_BOT_TOKEN=

# Your personal Telegram chat ID (get from @userinfobot — a numeric value).
# The bot will ONLY respond to this chat ID.
TELEGRAM_ADMIN_CHAT_ID=

# ─── Anthropic (Claude) ──────────────────────────────────────────────────────
# API key from https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ─── Google Gemini ───────────────────────────────────────────────────────────
# API key from https://aistudio.google.com (free tier is sufficient for text).
GOOGLE_API_KEY=
# gemini-3.5-flash is the current-gen workhorse (needs billing enabled).
# Free-tier alternative: gemini-3.5-flash-lite or gemini-2.5-flash-lite.
GEMINI_TEXT_MODEL=gemini-3.5-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image-preview

# ─── Meta / Facebook ─────────────────────────────────────────────────────────
META_APP_ID=
META_APP_SECRET=
# Numeric ID of the Uygun Georgia Facebook Page.
FB_PAGE_ID=
# Never-expiring Page Access Token (obtained via Graph API token exchange, see README).
FB_PAGE_ACCESS_TOKEN=

# ─── Runtime ─────────────────────────────────────────────────────────────────
# DRY_RUN=true: never call Facebook Graph API for publishing — log instead.
# Default to true during local dev; set to false in Railway only when ready.
DRY_RUN=true

TIMEZONE=Asia/Tbilisi
MONTHLY_BUDGET_USD=20
DATABASE_URL=sqlite:///data/uygun.db
LOG_LEVEL=INFO
